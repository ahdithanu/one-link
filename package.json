{
  "name": "one-link",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -p 3210",
    "build": "next build",
    "start": "next start -p 3210",
    "check": "node scripts/check-briefs.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test test/*.test.ts",
    "test:protocol": "tsx --test test/protocol.test.ts",
    "eval:tools": "tsx eval/tools.mts --strict",
    "eval:model": "tsx eval/model.mts",
    "smoke": "tsx eval/smoke-http.mts",
    "bench": "tsx eval/bench.mts",
    "test:redis": "tsx --test test-integration/*.test.ts",
    "report:logs": "tsx eval/log-report.mts",
    "check:env": "node scripts/check-env.mjs",
    "check:conformance": "node scripts/check-conformance.mjs",
    "eval:report": "tsx eval/quality-report.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@upstash/redis": "^1.41.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/blob": "^2.9.0",
    "next": "^15.5.29",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "22.18.0",
    "@types/react": "19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.33",
    "zod": "$zod"
